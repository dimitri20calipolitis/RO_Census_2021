# Load the library
library(tidyverse)
library(readxl)
library(scales)
library(paletteer)
library(treemapify)
library(ggpmisc)
library(gridExtra)
library(openxlsx)
library(olsrr)
library(jmv)
library(gtsummary)
library(MASS)
source("RO_Census_functions.R")
RO_Census_OLS <- read_excel("./RO_Census_Robust_Analysis_popsize.xlsx", sheet = 1)
RO_Census_ROB <- read_excel("./RO_Census_Robust_Analysis_popsize.xlsx", sheet = 2)
RO_Census_out_w <- read_excel("./RO_Census_Robust_Analysis_popsize.xlsx", sheet = 3)
RO_Census_all_regg_res <- read_excel("./RO_Census_Robust_Analysis_popsize.xlsx", sheet = 4)
RO_Census_best_OLS <- RO_Census_OLS %>% group_by(Judet_Name) %>%
mutate(rank_R2   = min_rank(desc(R_Squared)), rank_MAE  = min_rank(MAE),
rank_RMSE = min_rank(RMSE), rank_AIC  = min_rank(AIC),
rank_BIC  = min_rank(BIC), rank_sum = rank_R2 + rank_MAE + rank_RMSE +
rank_AIC + rank_BIC) %>% arrange(Judet_Name, rank_sum) %>% slice(1) %>%
ungroup() %>% dplyr::select(-c(rank_R2, rank_MAE, rank_RMSE, rank_AIC, rank_BIC, rank_sum))
RO_Census_best_OLS
RO_Census_best_Rob <- RO_Census_ROB %>% group_by(Judet_Name) %>%
mutate(rank_R2   = min_rank(desc(R_Squared)), rank_MAE  = min_rank(MAE),
rank_RMSE = min_rank(RMSE), rank_AIC  = min_rank(AIC),
rank_BIC  = min_rank(BIC), rank_sum = rank_R2 + rank_MAE + rank_RMSE +
rank_AIC + rank_BIC) %>% arrange(Judet_Name, rank_sum) %>% slice(1) %>%
ungroup() %>% dplyr::select(-c(rank_R2, rank_MAE, rank_RMSE, rank_AIC, rank_BIC, rank_sum))
RO_Census_best_Rob
RO_Census_best_OLS %>% dplyr::select(-Adj_R_Squared) %>% mutate(Regression_Type = "OLS")
bind_rows(
(RO_Census_best_OLS %>% dplyr::select(-Adj_R_Squared) %>%
mutate(Regression_Type = "OLS")),
(RO_Census_best_Rob %>% mutate(Regression_Type = "Robust"))
)
bind_rows(
(RO_Census_best_OLS %>% dplyr::select(-Adj_R_Squared) %>%
mutate(Regression_Type = "OLS")),
(RO_Census_best_Rob %>% mutate(Regression_Type = "Robust"))
) %>% arrange(Judet_Name) %>% relocate(Regression_Type, .after = Function_Name)
RO_Census_final <- bind_rows(
(RO_Census_best_OLS %>% dplyr::select(-Adj_R_Squared) %>%
mutate(Regression_Type = "OLS")),
(RO_Census_best_Rob %>% mutate(Regression_Type = "Robust"))
) %>% arrange(Judet_Name) %>% relocate(Regression_Type, .after = Function_Name)
write_csv(RO_Census_final, "./robust_comp.csv")
